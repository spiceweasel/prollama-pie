[Unit]
Description=prollama-pie local LLM process supervisor
After=network.target nginx.service
Wants=nginx.service

[Service]
Type=simple
User=prollama
Group=prollama
Environment=PRO_LLAMA_CONFIG=/etc/prollama-pie/config.json
ExecStart=/opt/prollama-pie/venv/bin/pro-llama-daemon
Restart=on-failure
RestartSec=3
UMask=0007
RuntimeDirectory=prollama-pie
RuntimeDirectoryMode=0770
StateDirectory=prollama-pie
StateDirectoryMode=0750
# Child llama-server processes intentionally survive a supervisor restart.
# On restart the supervisor validates PID + start time and reattaches.
KillMode=process
TimeoutStopSec=20
# Do not set NoNewPrivileges: restricted sudo helper must acquire root.
# Root-owned directories are protected by filesystem permissions.
ProtectHome=read-only
PrivateTmp=true
# Linux GPU nodes (/dev/kfd, /dev/dri) must remain visible to the service.

[Install]
WantedBy=multi-user.target
