{
  "manifest": "/var/lib/prollama-pie/proxy.json",
  "output": "/etc/nginx/conf.d/prollama-pie.conf",
  "cert": "/etc/nginx/ssl/prollama-pie.crt",
  "key": "/etc/nginx/ssl/prollama-pie.key",
  "admin_public_port": 8443,
  "admin_backend_port": 18765,
  "listen_address": "0.0.0.0",
  "server_name": "llama.home.arpa",
  "nginx_binary": "/usr/sbin/nginx",
  "reload_command": ["/usr/bin/systemctl", "reload", "nginx"]
}
